# ============ 翻译供应商 API key（至少配一个，或让用户登录后在「API 设置」里自助填写） ============
# PAPER_CHINA_ 前缀在所有场景生效（shell export、.env、Docker）。
# 不带前缀的裸名（DEEPSEEK_API_KEY 等）也被识别，作为兼容回退。
PAPER_CHINA_DEEPSEEK_API_KEY=
# PAPER_CHINA_OPENAI_API_KEY=
# PAPER_CHINA_MOONSHOT_API_KEY=
# PAPER_CHINA_ANTHROPIC_API_KEY=
# PAPER_CHINA_GLM_API_KEY=
# PAPER_CHINA_DEEPL_API_KEY=

# 必填：加密每用户供应商 key 的密钥。生成一次后保持稳定（丢失则用户需重填 key）：
# openssl rand -base64 32 | tr '+/' '-_'
PAPER_CHINA_CREDENTIAL_ENCRYPTION_KEY=

# ============ 翻译引擎与模型（可选） ============
# 引擎：native（自研保版式引擎，默认）或 pdf2zh（第三方回退）
# PAPER_CHINA_TRANSLATION_ENGINE=native
# 默认后端：deepseek / openai / kimi / anthropic / glm / google
# PAPER_CHINA_TRANSLATION_BACKEND=deepseek
# 模型与地址覆盖
# PAPER_CHINA_DEEPSEEK_MODEL=deepseek-v4-pro
# PAPER_CHINA_OPENAI_BASE_URL=https://api.openai.com/v1
# PAPER_CHINA_OPENAI_MODEL=gpt-4o-mini
# PAPER_CHINA_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# PAPER_CHINA_KIMI_MODEL=kimi-k3
# PAPER_CHINA_ANTHROPIC_MODEL=claude-sonnet-5
# PAPER_CHINA_GLM_MODEL=glm-5.2
# PAPER_CHINA_OLLAMA_HOST=http://localhost:11434

# ============ 公网部署必填 ============
# 强随机 bearer token；客户端以 "Authorization: Bearer <token>" 访问。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# PAPER_CHINA_API_TOKEN=
# 通知链接使用的公网地址，如 https://translate.example.com
# PAPER_CHINA_BASE_URL=http://localhost:8001

# 可选：多工作区隔离（"lab-a:token-a,lab-b:token-b"）
# PAPER_CHINA_WORKSPACE_TOKENS=

# ============ 服务行为（可选） ============
# PAPER_CHINA_DEBUG=true
# PAPER_CHINA_ALLOW_UNAUTHENTICATED_REMOTE=false
# 仅在自己可控的反向代理（如自带的 Caddy 方案）后开启，
# 让限流按 X-Forwarded-For 统计真实客户端 IP。
# PAPER_CHINA_TRUST_PROXY=true
# PAPER_CHINA_RATE_LIMIT_PER_MINUTE=60
# PAPER_CHINA_RATE_LIMIT_PER_HOUR=500
# 公网部署建议关闭交互式 API 文档（/docs /redoc）
# PAPER_CHINA_ENABLE_API_DOCS=true
# 跨域来源（逗号分隔）
# PAPER_CHINA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============ 上传与翻译并发（可选） ============
# 单个 PDF 大小上限（字节）；大文件走分块断点续传
# PAPER_CHINA_MAX_UPLOAD_SIZE=104857600
# 分块大小保持低于中间层请求体上限（默认 4 MiB）
# PAPER_CHINA_RESUMABLE_UPLOAD_CHUNK_SIZE=4194304
# PAPER_CHINA_RESUMABLE_UPLOAD_TTL_SECONDS=86400
# PAPER_CHINA_MAX_INCOMPLETE_UPLOADS_PER_USER=20
# 同时进行的翻译任务数；API key 支持并发才调高
# PAPER_CHINA_MAX_CONCURRENT_TRANSLATIONS=1
# 单个翻译内部的并行供应商请求数；限流 key 请设为 1
# PAPER_CHINA_TRANSLATION_CONCURRENCY=4
# 单次翻译超时（秒），长论文可调大
# PAPER_CHINA_TRANSLATION_TIMEOUT_SECONDS=1800

# ============ 通知与字体（可选） ============
# 翻译完成的飞书/Lark webhook 通知
# PAPER_CHINA_FEISHU_WEBHOOK_URL=
# 自定义中文字体（默认自动发现系统字体）
# PDF_ZH_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 字体子集缓存目录（默认 ~/.cache/paper-china/fonts）
# PAPER_CHINA_FONT_CACHE_DIR=
