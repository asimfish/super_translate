    "48": "content/icon.svg",
    "96": "content/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "supertranslate@asimfish.github.io",
      "update_url": "https://raw.githubusercontent.com/asimfish/super_translate/feat/zotero-plugin-20261015/zotero/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
